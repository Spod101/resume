# Groq API key for the portfolio AI assistant (components/ai/ai-chat.tsx).
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b.
# Other chat models that work well here:
#   openai/gpt-oss-20b   - faster and cheaper, slightly less careful
#   qwen/qwen3.8-27b     - alternative reasoning model
# Note: gpt-oss and qwen are reasoning models. The route sends
# reasoning_effort:"low" for them, since the reasoning pass counts against
# max_tokens and would otherwise truncate answers. Model families that reject
# that parameter (e.g. llama-*) are detected and it is omitted.
# Check what your key can access: https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b
